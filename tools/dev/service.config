# OpenSSL request configuration for the self-signed certificate of the local
# services (see generate-tls-certificate in the Makefile). It names only local
# development hosts: the local gateways use the reserved .test TLD (RFC 2606),
# so this certificate never claims the production domain.
[req]
x509_extensions = v3_req
distinguished_name = req_distinguished_name

[req_distinguished_name]

[v3_req]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment, keyCertSign
extendedKeyUsage = serverAuth, clientAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid, issuer
subjectAltName = @alt_names

[alt_names]
DNS.1 = localhost
DNS.2 = web-gateway.bucketeer.test
DNS.3 = api-gateway.bucketeer.test
DNS.4 = *.default.svc.cluster.local
DNS.5 = nginx
DNS.6 = web
DNS.7 = api
DNS.8 = batch
DNS.9 = subscriber
DNS.10 = mysql
DNS.11 = redis
