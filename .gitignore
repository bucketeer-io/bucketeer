tools/dev/cert/api_key_client
tools/dev/cert/api_key_server
# OAuth signing key pair and service token generated for local development by
# `make docker-compose-setup` / `make deploy-bucketeer`. Never commit these: the
# private key can mint system-admin tokens.
tools/dev/cert/oauth-private.pem
tools/dev/cert/oauth-public.pem
tools/dev/cert/service-token
# Key for encrypting stored secrets, generated by the same targets.
tools/dev/cert/encryption-key
# Self-signed TLS pairs for the local services and the local PostgreSQL,
# generated for local development by the same targets. Never commit these:
# production certificates belong in a Kubernetes TLS Secret, not in this
# directory.
tools/dev/cert/tls.crt
tools/dev/cert/tls.key
tools/dev/cert/postgres-tls.crt
tools/dev/cert/postgres-tls.key
# Key pairs and certificates that the Go tests used to load from testdata.
# The tests now generate their keys in t.TempDir(). Never commit a test key.
pkg/token/testdata/valid-private.pem
pkg/token/testdata/valid-public.pem
pkg/rpc/testdata/server.key
pkg/rpc/testdata/server.crt
pkg/rest/testdata/server.key
pkg/rest/testdata/server.crt
# Local build artifact from `go build ./hack/generate-service-token`
/generate-service-token
# e2e access tokens generated by hack/create-e2e-accounts
